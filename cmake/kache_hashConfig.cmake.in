# kache-hash's CMake package: the header-only table, `kache_hash::kache_hash`, and the components that were installed
# with it, `capi` (`kache_hash::kache_capi`) and `counter` (`kache_hash::kache_counter`). A `find_package` that names
# no components loads every installed one.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/kache_hashTargets.cmake")

set(_kache_hash_components ${kache_hash_FIND_COMPONENTS})
if(NOT _kache_hash_components)
    set(_kache_hash_components capi counter)
endif()
foreach(_kache_hash_component IN LISTS _kache_hash_components)
    set(_kache_hash_targets "${CMAKE_CURRENT_LIST_DIR}/kache_hash_${_kache_hash_component}Targets.cmake")
    if(_kache_hash_component MATCHES "^(capi|counter)$" AND EXISTS "${_kache_hash_targets}")
        include("${_kache_hash_targets}")
        set(kache_hash_${_kache_hash_component}_FOUND TRUE)
    else()
        set(kache_hash_${_kache_hash_component}_FOUND FALSE)
    endif()
endforeach()
unset(_kache_hash_targets)
unset(_kache_hash_component)
unset(_kache_hash_components)

check_required_components(kache_hash)
